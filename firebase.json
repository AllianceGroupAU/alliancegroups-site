{
  "functions": {
    "source": "firebase-backend/functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": {
    "rules": "firebase-backend/firestore.rules"
  },
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase-backend/**",
      ".firebase/**",
      ".github/**",
      ".git/**",
      ".gitignore",
      ".firebaserc",
      ".tours/**",
      ".vscode/**",
      "node_modules/**",
      ".next/**",
      "pages/**",
      "public/**",
      "quickstarts/**",
      "tests/**",
      "package.json",
      "package-lock.json",
      "next.config.js",
      "vercel.json",
      "firebase.json",
      "README.md",
      "DNS_AND_REDIRECT_SETUP.md",
      "godaddy_dns_zone.txt",
      "seo_audit_script.py",
      "seo_inventory.csv",
      "index-original.html",
      "index-static-backup.html",
      "**/*.log",
      "**/*.py",
      "**/*.sh",
      "**/*.csv"
    ]
  }
}
